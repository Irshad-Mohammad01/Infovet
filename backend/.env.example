# ==============================================================================
# INFOVATE – Backend Environment Configuration Template
# ==============================================================================
# Copy this file to backend/.env and configure for your local or production environment.
# Note: backend/.env is gitignored and must never be committed to source control.

# --- Platform & Server --------------------------------------------------------
ENVIRONMENT=development
PORT=8000

# --- Neon PostgreSQL Database -------------------------------------------------
# Neon connection string with SSL required.
# Example:
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xyz-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Local SQLite fallback for testing:
#   DATABASE_URL=sqlite:///./infovate.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Database Connection Pooling (optimized for serverless compute like Neon)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# --- JWT Authentication & Security --------------------------------------------
# Generate a secure 32+ character random string for production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-char-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- File Storage -------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- Frontend & CORS ----------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://127.0.0.1:5173"]

# --- SMTP Outbound Email (Prepared - Inactive by default) ----------------------
# Email services will simulate in logs until an active SMTP host and credentials
# are configured. Leaving SMTP_HOST blank keeps the application running smoothly.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=no-reply@infovate.io
SMTP_SENDER_NAME=Infovate
SMTP_USE_TLS=true
SMTP_USE_SSL=false
CONTACT_RECEIVER_EMAIL=admin@infovate.io

# --- Rate Limiting Protection -------------------------------------------------
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_SECONDS=60
